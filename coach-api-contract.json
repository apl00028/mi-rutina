{
  "endpoint": "POST /coach/review",
  "request": {
    "version": "3.0.0",
    "generatedAt": "ISO-8601",
    "settings": "Coach settings",
    "routine": "Current A/B/C routine",
    "recentWorkouts": "Recent completed workouts",
    "exerciseSummary": "Aggregated performance by exercise",
    "bodyWeight": "Weight history",
    "activeBlock": "Current training block"
  },
  "response": {
    "id": "optional string",
    "summary": "string",
    "notes": [
      "string"
    ],
    "changes": [
      {
        "type": "progression|fatigue|stagnation|substitution",
        "session": "A|B|C",
        "index": 0,
        "exercise": "Exercise name",
        "field": "sets|increment|target|name",
        "from": "old value",
        "to": "new value",
        "reason": "string"
      }
    ]
  },
  "version": "3.8.3",
  "health": {
    "endpoint": "GET /health"
  },
  "chat": {
    "endpoint": "POST /coach/chat",
    "request": {
      "message": "string",
      "history": "recent chat messages",
      "context": "GymOS training context"
    },
    "response": {
      "message": "string",
      "actions": [
        "string"
      ],
      "proposal": "optional structured routine proposal"
    }
  },
  "nutrition_context": {
    "settings": "calorie and macro targets",
    "recentEntries": "last nutritional logs",
    "weeklySummary": "7-day averages",
    "weightTrend": "body-weight trend",
    "bodyCompositionAssessment": "comparison with weekly target"
  },
  "health_context": {
    "settings": "health targets and optional baselines",
    "recentEntries": "sleep, steps, resting heart rate, HRV and active calories",
    "baselines": "rolling 30-day averages or manual baselines",
    "recovery": "non-medical readiness score",
    "weeklySummary": "7-day averages",
    "imports": "recent CSV imports"
  },
  "authentication": {
    "status": "client account foundation",
    "provider": "Supabase Auth",
    "supported": [
      "email_password",
      "google_oauth",
      "password_reset"
    ],
    "data_isolation": "PostgreSQL Row Level Security by auth.uid()",
    "production_note": "Coach backend authentication and rate limiting remain required before public launch"
  },
  "sync_protocol": {
    "schemaVersion": 2,
    "fields": [
      "revision",
      "deviceId",
      "updatedAt",
      "checksum",
      "payload"
    ],
    "conflict_modes": [
      "ask",
      "local",
      "remote"
    ]
  },
  "timed_exercises": {
    "supported": true,
    "stored_field": "seconds",
    "controls": [
      "start",
      "stop",
      "reset"
    ],
    "behavior": "stopping writes elapsed seconds into the current set"
  }
}