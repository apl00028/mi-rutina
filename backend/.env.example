# Proveedor: rules | gemini | openai | ollama
AI_PROVIDER=rules
AI_DAILY_LIMIT_PER_USER=10

# Gemini: el modelo se elige exclusivamente desde el entorno.
GEMINI_API_KEY=
# Modelo rápido configurable desde el entorno; revisa su disponibilidad en tu proyecto.
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API es independiente de una suscripción de ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama debe ser accesible desde el servidor donde se ejecuta este backend.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# Autenticación de usuarios del backend mediante Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

ALLOWED_ORIGINS=https://TU_USUARIO.github.io,http://localhost:8000

SUPABASE_SERVICE_ROLE_KEY=
